{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "AGY Development Contract",
  "type": "object",
  "required": ["goal", "behavior", "done"],
  "properties": {
    "goal": {"type": "string", "minLength": 1},
    "behavior": {"type": "array", "items": {"type": "string", "minLength": 1}, "minItems": 1},
    "constraints": {"type": "array", "items": {"type": "string", "minLength": 1}, "default": []},
    "done": {"type": "array", "items": {"type": "string", "minLength": 1}, "minItems": 1},
    "escalate_if": {"type": "array", "items": {"type": "string", "minLength": 1}, "default": []},
    "architecture_intent": {"type": "array", "items": {"type": "string", "minLength": 1}, "default": []},
    "out_of_scope": {"type": "array", "items": {"type": "string", "minLength": 1}, "default": []}
  },
  "additionalProperties": false
}
