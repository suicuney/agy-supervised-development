{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "AGY Frozen Test Plan 4.1",
  "type": "object",
  "required": ["schema_version", "task_id", "contract_id", "contract_revision", "contract_digest", "policy_digest", "plan_id", "plan_revision", "reviewed_deliverable_digest", "status", "checks", "no_checks_acceptance"],
  "properties": {
    "schema_version": {"const": 3},
    "task_id": {"type": "string", "minLength": 1},
    "contract_id": {"type": "string", "minLength": 1},
    "contract_revision": {"type": "integer", "minimum": 1},
    "contract_digest": {"$ref": "#/$defs/digest"},
    "policy_digest": {"$ref": "#/$defs/digest"},
    "plan_id": {"type": "string", "minLength": 1},
    "plan_revision": {"type": "integer", "minimum": 1},
    "reviewed_deliverable_digest": {"$ref": "#/$defs/digest"},
    "status": {"const": "FROZEN"},
    "notes": {"type": "array", "items": {"type": "string", "minLength": 1}},
    "manual_confirmation_required": {"type": "boolean"},
    "checks": {"type": "array", "items": {"$ref": "#/$defs/commandCheck"}},
    "no_checks_acceptance": {"oneOf": [{"type": "null"}, {"$ref": "#/$defs/noChecks"}]}
  },
  "$defs": {
    "digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "commandCheck": {
      "type": "object",
      "required": ["id", "cwd", "argv", "expected_exit_codes", "timeout_seconds", "max_attempts"],
      "properties": {
        "id": {"type": "string", "pattern": "^[A-Za-z0-9._-]+$"},
        "cwd": {"type": "string", "minLength": 1},
        "argv": {"type": "array", "minItems": 1, "items": {"type": "string"}},
        "expected_exit_codes": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "integer"}},
        "timeout_seconds": {"type": "number", "exclusiveMinimum": 0, "maximum": 86400},
        "max_attempts": {"type": "integer", "minimum": 1, "maximum": 10},
        "input_paths": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
        "expected": {"type": "string"}
      },
      "additionalProperties": false
    },
    "noChecks": {
      "type": "object",
      "required": ["reason", "evidence_path", "evidence_sha256"],
      "properties": {
        "reason": {"type": "string", "minLength": 1},
        "evidence_path": {"type": "string", "minLength": 1},
        "evidence_sha256": {"$ref": "#/$defs/digest"}
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
