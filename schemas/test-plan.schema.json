{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "title":"AGY Test Plan 4.1",
  "type":"object",
  "required":["schema_version","task_id","contract_id","contract_revision","plan_id","plan_revision","reviewed_deliverable_digest","status","checks","metrics"],
  "properties":{
    "schema_version":{"const":1},
    "task_id":{"type":"string","minLength":1},
    "contract_id":{"type":"string","minLength":1},
    "contract_revision":{"type":"integer","minimum":1},
    "plan_id":{"type":"string","minLength":1},
    "plan_revision":{"type":"integer","minimum":1},
    "reviewed_deliverable_digest":{"type":"string","pattern":"^[0-9a-f]{64}$"},
    "status":{"const":"FROZEN"},
    "checks":{"type":"array","items":{"$ref":"#/$defs/check"}},
    "metrics":{"type":"array","items":{"$ref":"#/$defs/metric"}},
    "no_checks_acceptance":{"anyOf":[{"type":"null"},{"$ref":"#/$defs/noChecks"}]}
  },
  "allOf":[{"if":{"properties":{"checks":{"maxItems":0}}},"then":{"required":["no_checks_acceptance"],"properties":{"no_checks_acceptance":{"$ref":"#/$defs/noChecks"}}}}],
  "$defs":{
    "applicability":{"oneOf":[
      {"type":"object","required":["mode"],"properties":{"mode":{"const":"always"}},"additionalProperties":false},
      {"type":"object","required":["mode","fact","value"],"properties":{"mode":{"const":"fact_eq"},"fact":{"type":"string","minLength":1},"value":{"type":["string","number","integer","boolean"]}},"additionalProperties":false}
    ]},
    "command":{"type":"object","required":["argv","expected_exit_codes","timeout_seconds"],"properties":{"argv":{"type":"array","minItems":1,"items":{"type":"string"}},"expected_exit_codes":{"type":"array","minItems":1,"uniqueItems":true,"items":{"type":"integer"}},"timeout_seconds":{"type":"integer","minimum":1,"maximum":86400}},"additionalProperties":false},
    "observation":{"type":"object","required":["steps","evidence_required"],"properties":{"steps":{"type":"array","minItems":1,"items":{"type":"string","minLength":1}},"evidence_required":{"const":true}},"additionalProperties":false},
    "check":{"type":"object","required":["id","type","cwd","required","applicability","evidence_types","max_attempts"],"properties":{"id":{"type":"string","minLength":1},"type":{"enum":["command","observation"]},"cwd":{"type":"string","minLength":1},"required":{"type":"boolean"},"applicability":{"$ref":"#/$defs/applicability"},"evidence_types":{"type":"array","minItems":1,"uniqueItems":true,"items":{"enum":["log","json","artifact","screenshot","manual_observation"]}},"max_attempts":{"type":"integer","minimum":1,"maximum":10},"input_paths":{"type":"array","uniqueItems":true,"items":{"type":"string","minLength":1}},"expected":{"type":"string"},"command":{"$ref":"#/$defs/command"},"observation":{"$ref":"#/$defs/observation"}},"allOf":[{"if":{"properties":{"type":{"const":"command"}}},"then":{"required":["command"]}},{"if":{"properties":{"type":{"const":"observation"}}},"then":{"required":["observation"]}}],"additionalProperties":false},
    "metric":{"type":"object","required":["id","source_check_id","result_field","op","threshold","required"],"properties":{"id":{"type":"string","minLength":1},"source_check_id":{"type":"string","minLength":1},"result_field":{"type":"string","minLength":1},"op":{"enum":["eq","ge","le"]},"threshold":{"type":["number","integer","string","boolean"]},"unit":{"type":["string","null"]},"required":{"type":"boolean"},"description":{"type":"string"}},"additionalProperties":false},
    "noChecks":{"type":"object","required":["reason","evidence_ref","evidence_sha256"],"properties":{"reason":{"type":"string","minLength":1},"evidence_ref":{"type":"string","minLength":1},"evidence_sha256":{"type":"string","pattern":"^[0-9a-f]{64}$"}},"additionalProperties":false}
  },
  "additionalProperties":false
}
