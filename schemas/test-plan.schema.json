{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "title":"AGY Frozen Test Plan 4.1",
  "type":"object",
  "required":["schema_version","task_id","contract_id","contract_revision","contract_digest","policy_digest","plan_id","plan_revision","reviewed_deliverable_digest","status","checks","metrics","no_checks_acceptance"],
  "properties":{
    "schema_version":{"const":2},"task_id":{"type":"string","minLength":1},"contract_id":{"type":"string","minLength":1},"contract_revision":{"type":"integer","minimum":1},
    "contract_digest":{"$ref":"#/$defs/digest"},"policy_digest":{"$ref":"#/$defs/digest"},"plan_id":{"type":"string","minLength":1},"plan_revision":{"type":"integer","minimum":1},
    "reviewed_deliverable_digest":{"$ref":"#/$defs/digest"},"status":{"const":"FROZEN"},
    "checks":{"type":"array","items":{"oneOf":[{"$ref":"#/$defs/commandCheck"},{"$ref":"#/$defs/observationCheck"}]}},
    "metrics":{"type":"array","items":{"$ref":"#/$defs/metric"}},
    "no_checks_acceptance":{"oneOf":[{"type":"null"},{"$ref":"#/$defs/noChecks"}]}
  },
  "$defs":{
    "digest":{"type":"string","pattern":"^[0-9a-f]{64}$"},
    "source":{"type":"object","required":["path","json_path","value_type"],"properties":{"path":{"type":"string","minLength":1},"json_path":{"type":"string","minLength":1},"value_type":{"enum":["boolean","integer","number","string"]}},"additionalProperties":false},
    "condition":{"type":"object","required":["mode"],"properties":{"mode":{"enum":["always","fact_eq"]},"source":{"$ref":"#/$defs/source"},"expected":{}},"allOf":[{"if":{"properties":{"mode":{"const":"fact_eq"}}},"then":{"required":["source","expected"]}}],"additionalProperties":false},
    "environment":{"type":"object","required":["id","source","op","expected"],"properties":{"id":{"type":"string","minLength":1},"source":{"$ref":"#/$defs/source"},"op":{"const":"eq"},"expected":{}},"additionalProperties":false},
    "reportField":{"type":"object","required":["name","json_path","value_type"],"properties":{"name":{"type":"string","minLength":1},"json_path":{"type":"string","minLength":1},"value_type":{"enum":["boolean","integer","number","string"]},"unit":{"type":["string","null"]}},"additionalProperties":false},
    "report":{"type":"object","required":["id","path","fields"],"properties":{"id":{"type":"string","minLength":1},"path":{"type":"string","minLength":1},"fields":{"type":"array","minItems":1,"items":{"$ref":"#/$defs/reportField"}}},"additionalProperties":false},
    "baseCheck":{"type":"object","required":["id","type","cwd","required","covers","applicability","environment_prerequisites","evidence_types","max_attempts","expected"],"properties":{"id":{"type":"string","pattern":"^[A-Za-z0-9._-]+$"},"type":{"enum":["command","observation"]},"cwd":{"type":"string","minLength":1},"required":{"type":"boolean"},"covers":{"type":"array","uniqueItems":true,"items":{"type":"string","minLength":1}},"applicability":{"$ref":"#/$defs/condition"},"environment_prerequisites":{"type":"array","items":{"$ref":"#/$defs/environment"}},"evidence_types":{"type":"array","uniqueItems":true,"items":{"enum":["stdout","stderr","structured_report","observation","applicability","environment"]}},"max_attempts":{"type":"integer","minimum":1,"maximum":10},"expected":{"type":"string","minLength":1}},"additionalProperties":true},
    "commandCheck":{"allOf":[{"$ref":"#/$defs/baseCheck"},{"properties":{"type":{"const":"command"},"command":{"type":"object","required":["argv","expected_exit_codes","timeout_seconds"],"properties":{"argv":{"type":"array","minItems":1,"items":{"type":"string"}},"expected_exit_codes":{"type":"array","minItems":1,"uniqueItems":true,"items":{"type":"integer"}},"timeout_seconds":{"type":"number","exclusiveMinimum":0,"maximum":86400}},"additionalProperties":false},"structured_reports":{"type":"array","items":{"$ref":"#/$defs/report"}}},"required":["command","structured_reports"]}]},
    "observationCheck":{"allOf":[{"$ref":"#/$defs/baseCheck"},{"properties":{"type":{"const":"observation"},"observation":{"type":"object","required":["source","op","expected"],"properties":{"source":{"$ref":"#/$defs/source"},"op":{"enum":["eq","ge","le"]},"expected":{}},"additionalProperties":false}},"required":["observation"]}]},
    "metric":{"type":"object","required":["id","source_check_id","result_field","op","threshold","value_type","unit","required"],"properties":{"id":{"type":"string","minLength":1},"source_check_id":{"type":"string","minLength":1},"result_field":{"type":"string","minLength":1},"op":{"enum":["eq","ge","le"]},"threshold":{},"value_type":{"enum":["boolean","integer","number","string"]},"unit":{"type":["string","null"]},"required":{"type":"boolean"}},"additionalProperties":false},
    "noChecks":{"type":"object","required":["covers","reason","evidence_path","evidence_sha256"],"properties":{"covers":{"type":"array","minItems":1,"uniqueItems":true,"items":{"type":"string","minLength":1}},"reason":{"type":"string","minLength":1},"evidence_path":{"type":"string","minLength":1},"evidence_sha256":{"$ref":"#/$defs/digest"}},"additionalProperties":false}
  },
  "additionalProperties":false
}
