{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "title":"AGY Test Results 4.1",
  "type":"object",
  "required":["schema_version","task_id","contract_id","contract_revision","plan_id","plan_revision","plan_digest","results"],
  "properties":{
    "schema_version":{"const":1},
    "task_id":{"type":"string","minLength":1},
    "contract_id":{"type":"string","minLength":1},
    "contract_revision":{"type":"integer","minimum":1},
    "plan_id":{"type":"string","minLength":1},
    "plan_revision":{"type":"integer","minimum":1},
    "plan_digest":{"type":"string","pattern":"^[0-9a-f]{64}$"},
    "results":{"type":"array","items":{"$ref":"#/$defs/result"}}
  },
  "$defs":{"result":{"type":"object","required":["check_id","attempt_id","attempt_number","status","cwd","started_at","ended_at","measured_values","evidence_refs","deliverable_digest_before","deliverable_digest_after","reason"],"properties":{"check_id":{"type":"string","minLength":1},"attempt_id":{"type":"string","minLength":1},"attempt_number":{"type":"integer","minimum":1},"status":{"enum":["PASS","FAIL","BLOCKED","NOT_RUN","NOT_APPLICABLE","STALE"]},"cwd":{"type":"string","minLength":1},"started_at":{"type":"string","format":"date-time"},"ended_at":{"type":"string","format":"date-time"},"actual_argv":{"type":["array","null"],"items":{"type":"string"}},"exit_code":{"type":["integer","null"]},"observation_completed":{"type":["boolean","null"]},"applicability_evidence":{"type":["object","null"],"properties":{"fact":{"type":"string"},"value":{"type":["string","number","integer","boolean"]},"evidence_ref":{"type":"string"}},"required":["fact","value","evidence_ref"],"additionalProperties":false},"measured_values":{"type":"object"},"evidence_refs":{"type":"array","minItems":1,"items":{"type":"object","required":["path","sha256"],"properties":{"path":{"type":"string","minLength":1},"sha256":{"type":"string","pattern":"^[0-9a-f]{64}$"},"summary":{"type":"string"}},"additionalProperties":false}},"deliverable_digest_before":{"type":"string","pattern":"^[0-9a-f]{64}$"},"deliverable_digest_after":{"type":"string","pattern":"^[0-9a-f]{64}$"},"reason":{"type":"string"}},"additionalProperties":false}},
  "additionalProperties":false
}
